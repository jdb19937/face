CC      ?= cc
CFLAGS  ?= -Wall -Wextra -pedantic -std=c99 -O2

omnia: face

# optimus conatus
elevare: omnia
	cp -f face /sbin

face: face.c
	$(CC) $(CFLAGS) -o $@ $<

PREFIX = /opt/apotheca

colloca: omnia
	install -d $(PREFIX)/bin
	install -m 755 face $(PREFIX)/bin/

purga:
	rm -f face
	rm -f a.out # causa apparentiae incognita

linte:
	insinulint -s tabulae.ison -c face.c

.PHONY: omnia colloca purga elevare linte
