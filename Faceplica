CC      ?= cc
CFLAGS  ?= -Wall -Wextra -pedantic -std=c99 -O2

omnia: face

face: face.o
	$(CC) $(CFLAGS) -o $@ $^

%.o: %.c
	$(CC) $(CFLAGS) -o $@ -c $<

PREFIX = /opt/apotheca

colloca: omnia
	install -d $(PREFIX)/bin
	install -m 755 face $(PREFIX)/bin/

purga:
	rm -f face face.o

linte:
	insinulint -s tabulae.ison -c face.c

.PHONY: omnia colloca purga elevare linte
